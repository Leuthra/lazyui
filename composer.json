{
    "name": "lazyui/lazyui",
    "description": "LazyUI: Blade + Alpine components and a full LazyUI design for Filament 5 panels (Laravel 12/13, Livewire 4). Fork of ilsyaa/lazyui.",
    "keywords": [
        "laravel",
        "filament",
        "filament-plugin",
        "livewire",
        "tailwind",
        "blade",
        "components",
        "theme",
        "lazyui"
    ],
    "homepage": "https://github.com/Leuthra/lazyui",
    "license": "MIT",
    "type": "library",
    "authors": [
        {
            "name": "Ilsyaa",
            "homepage": "https://github.com/ilsyaa",
            "role": "Original author"
        },
        {
            "name": "Leuthra",
            "homepage": "https://github.com/Leuthra",
            "role": "Maintainer of this fork"
        }
    ],
    "support": {
        "issues": "https://github.com/Leuthra/lazyui/issues",
        "source": "https://github.com/Leuthra/lazyui"
    },
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "gehrisandro/tailwind-merge-php": "^1.2",
        "illuminate/support": "^12.0|^13.0",
        "livewire/livewire": "^4.0"
    },
    "require-dev": {
        "laravel/pint": "^1.20",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "LazyUI\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "LazyUI\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/",
            "Workbench\\Database\\Seeders\\": "workbench/database/seeders/"
        }
    },
    "scripts": {
        "test": "phpunit",
        "format": "pint",
        "lint": "pint --test",
        "post-autoload-dump": [
            "@clear",
            "@prepare"
        ],
        "clear": "@php vendor/bin/testbench package:purge-skeleton --ansi",
        "prepare": "@php vendor/bin/testbench package:discover --ansi",
        "workbench": [
            "@php vendor/bin/testbench workbench:build --ansi",
            "@php vendor/bin/testbench filament:assets --ansi",
            "npm run build:workbench"
        ],
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "@php vendor/bin/testbench serve --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "providers": [
                "LazyUI\\LazyUIServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
